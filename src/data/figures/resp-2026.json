{"entries":[{"expires":"2027-01-01","key":"resp.lifetime_cap","label":"RESP lifetime contribution cap per beneficiary","notes":"Excess above the cap: 1%/month tax.","source":"https://www.canada.ca/en/employment-social-development/services/education-savings/registered-education-savings-plan.html","source_note":"ESDC RESP page (resp-basics-research, verified 2026-09-27).","status":"verified","unit":"cad","value":50000,"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"resp.plan_lifespan","label":"RESP maximum lifespan","notes":"","source":"https://www.canada.ca/en/employment-social-development/services/education-savings/registered-education-savings-plan.html","source_note":"ESDC RESP page (resp-basics-research, verified 2026-09-27).","status":"verified","unit":"table","value":{"contributions_stop_age":31,"max_open_years":35},"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"cesg.rate","label":"Canada Education Savings Grant (CESG) basic rate","notes":"CESG is tax-free growth inside the RESP; tax deferred until EAP withdrawal.","source":"https://www.canada.ca/en/employment-social-development/services/education-savings/canada-education-savings-grant.html","source_note":"ESDC CESG page (resp-basics-research, verified 2026-09-27).","status":"verified","unit":"table","value":{"annual_contribution_match_base":2500,"annual_max":500,"lifetime_max":7200,"rate":0.2},"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"cesg.catch_up","label":"CESG catch-up room","notes":"$209/mo x 12 = ~$2,508/yr is the sweet spot to capture the full $500 + $500 catch-up without overshooting the $50,000 lifetime cap. $7200 cap is hit around age 14 at $2,500/yr.","source":"https://www.canada.ca/en/employment-social-development/services/education-savings/canada-education-savings-grant.html","source_note":"ESDC CESG page (resp-basics-research, verified 2026-09-27).","status":"verified","unit":"table","value":{"annual_catchup_max":1000,"contribution_for_full_catchup":5000,"lifetime_cap_hit_age_approx":14},"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"cesg.eligibility","label":"CESG eligibility","notes":"16/17-year-old special rule: at least $2,000 contributed and not withdrawn, or at least $100/yr in any 4 previous years.","source":"https://www.canada.ca/en/employment-social-development/services/education-savings/canada-education-savings-grant.html","source_note":"ESDC CESG page (resp-basics-research, verified 2026-09-27).","status":"verified","unit":"text","value":"Birth through December 31 of the year the child turns 17","verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"acesg.thresholds.2026","label":"Additional CESG (A-CESG) 2026 income thresholds","notes":"A-CESG applies to the first $500 of contributions. Net family income from the prior tax year.","source":"https://www.canada.ca/en/employment-social-development/services/education-savings/canada-education-savings-grant/additional-cesg.html","source_note":"ESDC A-CESG page (resp-basics-research, verified 2026-09-27). Thresholds tie to the 2026 federal bracket boundaries.","status":"verified","unit":"table","value":{"extra_10_percent_max_income":117045,"extra_20_percent_max_income":58523,"on_first_500":{"base_cesg":100,"extra_10_percent":50,"extra_20_percent":100}},"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"clb.amounts","label":"Canada Learning Bond (CLB) amounts","notes":"No contributions required. Retroactive: eligible children born on/after Jan 1, 2004 can claim CLB retroactively up to the day before their 21st birthday.","source":"https://www.canada.ca/en/employment-social-development/services/education-savings/canada-learning-bond.html","source_note":"ESDC CLB page (resp-basics-research, verified 2026-09-27).","status":"verified","unit":"table","value":{"first_year":500,"lifetime_max":2000,"subsequent_annual_to_age_15":100},"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"qesi.amounts","label":"Quebec Education Savings Incentive (QESI)","notes":"Quebec-only.","source":"https://www.revenuquebec.ca/en/citizens/personal-income-tax/tax-credits/education-savings-incentive/","source_note":"Revenu Quebec QESI page (resp-basics-research, verified 2026-09-27).","status":"verified","unit":"table","value":{"lifetime_max":3600,"rate":0.1,"rate_extra_on_first_500":{"lower_incomes":0.1,"standard":0.05,"yearly_cap_extra":50},"yearly_max":250},"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"bctesg.amount","label":"BC Training and Education Savings Grant","notes":"One-time; claimed via bank/credit union; ages 6-9 window.","source":"https://www2.gov.bc.ca/gov/content/education-training/k-12/support/bctesg","source_note":"BC government BCTESG page (resp-basics-research, verified 2026-09-27).","status":"verified","unit":"cad","value":1200,"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"sages.status","label":"Saskatchewan Advantage Grant for Education Savings (SAGES)","notes":"DO NOT include SAGES as a live grant in any copy.","rejected":[{"claim":"SAGES as an active RESP grant","reason":"Suspended since January 1, 2018; contributions no longer receive SAGES. Kept here so it is not reintroduced.","reported_by":"resp-basics-research.md, 2026-09-27"}],"source":"https://www.saskatchewan.ca/residents/education-and-learning/preschool-and-early-learning/child-care/saskatchewan-advantage-grant-for-education-savings-sages","source_note":"Saskatchewan government SAGES page (suspended since 2018-01-01).","status":"rejected","unit":"text","value":"SUSPENDED since 2018-01-01 - not a live grant","verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"eap.limits","label":"Educational Assistance Payment (EAP) initial limits","notes":"EAPs are taxed in the student's hands (usually low income). Unused EAPs after 6 months can be topped up.","source":"https://www.canada.ca/en/employment-social-development/services/education-savings/educational-assistance-payment.html","source_note":"ESDC 