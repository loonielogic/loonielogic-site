d","value":8460.9,"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"cpp.yampe.2026","label":"2026 CPP second ceiling (YAMPE)","notes":"Base + enhancement phases in; full 33.33% replacement target reached with CPP2 fully implemented.","source":"https://www.canada.ca/en/services/benefits/publicpensions/cpp/contributions.html","source_note":"CRA CPP contributions page.","status":"verified","unit":"cad","value":85000,"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"cpp.cpp2_rate.2026","label":"2026 CPP2 (second tier) employee/employer rate","notes":"Applied to income between YMPE and YAMPE.","source":"https://www.canada.ca/en/services/benefits/publicpensions/cpp/contributions.html","source_note":"CRA CPP contributions page.","status":"verified","unit":"pct","value":0.04,"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"cpp.cpp2_employee_max.2026","label":"2026 CPP2 maximum employee contribution","notes":"($85,000 - $74,600) x 4% = $416. Self-employed: 8% / $832.","source":"https://www.canada.ca/en/services/benefits/publicpensions/cpp/contributions.html","source_note":"CRA CPP contributions page.","status":"verified","unit":"cad","value":416,"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"cpp.cpp2_self_max.2026","label":"2026 CPP2 maximum self-employed contribution","notes":"8% x ($85,000 - $74,600).","source":"https://www.canada.ca/en/services/benefits/publicpensions/cpp/contributions.html","source_note":"CRA CPP contributions page.","status":"verified","unit":"cad","value":832,"verified_date":"2026-09-27"},{"expires":"2027-01-01","key":"cpp.max_benefit_65","label":"Maximum CPP monthly retirement pension at age 65 (new beneficiaries, 2026)","notes":"January 2026 figure; grows through the year as enhancement phases in (Dec 2026 ~ $1,524.78). January 2026 indexation +2.0%. Q4 2026 new-benefit max should be re-checked; January 2027 edition resets.","source":"https://www.canada.ca/en/employment-social-development/programs/pensi