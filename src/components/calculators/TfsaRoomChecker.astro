---
/**
 * TfsaRoomChecker: the TFSA Over-Contribution Risk Checker island. Plain
 * Astro markup plus one TypeScript <script> (no framework). With JS off, all
 * six questions show as one form and the results area shows the worked
 * example, rendered at build time. With JS on, the questions run one per
 * screen and the results render from the user's answers with the same
 * functions.
 */
import "../../styles/calc-kit.css";
import {
  ANNUAL_LIMIT,
  CURRENT_YEAR,
  CUMULATIVE_MAX,
  EXCESS_TAX_RATE,
  FIRST_TFSA_YEAR,
  FORMAL_TRANSFER,
  RC243_DEADLINE,
  check,
  josieExample,
  tfsaFigures,
} from "../../lib/calculators/tfsa-room-checker";
import { HELP, renderExample, renderNextSteps, renderResults, sourceTag, longDate, pct, $, RESTORE_DATE, MY_ACCOUNT_URL, trcNextFigures } from "../../lib/calculators/tfsa-room-checker-render";

interface Props {
  /** Target for "fixing an over-contribution" links. */
  fixGuideHref: string;
}
const { fixGuideHref } = Astro.props;

const asOf = longDate(new Date().toISOString().slice(0, 10));
const initialHtml = renderResults(check(josieExample()), { fixGuideHref, asOf, example: true });
const years = Array.from({ length: CURRENT_YEAR - FIRST_TFSA_YEAR + 1 }, (_, k) => FIRST_TFSA_YEAR + k);
const sources = [...tfsaFigures.values(), ...trcNextFigures.values()];
const src = (key: string) => sourceTag(key);
const TOTAL = 6;
---

<div class="trc" id="trc" data-fix-href={fixGuideHref}>
  <form class="trc-form" id="trc-form" novalidate>
    <ol class="trc-progress" id="trc-progress" hidden aria-label="Questions">
      {["Birth year", "Residency", "Years away", "Deposits", "Past withdrawals", `${CURRENT_YEAR} withdrawals`].map((t, k) => (
        <li><button type="button" data-goto={k + 1} disabled={k > 0}><span class="trc-num">{k + 1}</span><span class="trc-step-name">{t}</span></button></li>
      ))}
    </ol>

    <fieldset class="trc-step" data-step="1">
      <legend>What year were you born?</legend>
      <label>Birth year
        <small class="ck-help">{HELP.birthYear}</small>
        <input type="number" name="birthYear" inputmode="numeric" min="1900" max={CURRENT_YEAR} step="1" placeholder="e.g. 1990" />
      </label>
      <p class="trc-derived" data-derived="age18" aria-live="polite"></p>
      <p class="trc-error" data-error-for="birthYear" hidden></p>
      <small>TFSA room starts the year you turn 18, with the full limit for that year even if your birthday is late in the year. You also need to be a Canadian resident with a valid SIN <Fragment set:html={src("tfsa.eligibility")} />.</small>
    </fieldset>

    <fieldset class="trc-step" data-step="2">
      <legend>Did you become a Canadian tax resident after turning 18?</legend>
      <small class="ck-help">{HELP.residentLater}</small>
      <label class="trc-radio"><input type="radio" name="residentLater" value="no" checked /> No, I was a resident when I turned 18 (or since 2009)</label>
      <label class="trc-radio"><input type="radio" name="residentLater" value="yes" /> Yes, I became a resident later</label>
      <label data-show="residency" hidden>Year you became a Canadian tax resident
        <small class="ck-help">{HELP.residencyYear}</small>
        <input type="number" name="residencyYear" inputmode="numeric" min="1900" max={CURRENT_YEAR} step="1" placeholder={`e.g. ${CURRENT_YEAR - 2}`} />
      </label>
      <p class="trc-error" data-error-for="residencyYear" hidden></p>
      <small>Newcomers start building room the year they become a Canadian resident, not from 2009 <Fragment set:html={src("tfsa.eligibility")} />. Room starts in whichever is later: the year you turn 18 or the year you became a resident.</small>
    </fieldset>

    <fieldset class="trc-step" data-step="3">
      <legend>Any full years as a non-resident since then?</legend>
      <p class="trc-help">Tick each calendar year you were a non-resident of Canada for the <strong>whole</strong> year. No room builds for those years, so the checker takes out that year's limit. Leave them all blank if none.</p>
      <small class="ck-help">{HELP.nonResidentYears}</small>
      <div class="trc-years-grid">
        {years.map((y) => (
          <label class="trc-check" data-year={y}><input type="checkbox" name="nonResidentYears" value={y} /> {y}</label>
        ))}
      </div>
      <p class="trc-error" data-error-for="nonResidentYears" hidden></p>
    </fieldset>

    <fieldset class="trc-step" data-step="4">
      <legend>How much have you deposited into TFSAs, ever?</legend>
      <label>Total lifetime contributions ($)
        <small class="ck-help">{HELP.lifetimeContributions}</small>
        <input type="number" name="lifetimeContributions" inputmode="numeric" min="0" step="100" placeholder="0" />
      </label>
      <p class="trc-error" data-error-for="lifetimeContributions" hidden></p>
      <p class="trc-warning" data-warning-for="lifetimeContributions" hidden></p>
      <small><strong>Contributions means every dollar you ever deposited, even if you later withdrew it.</strong> Include all banks and brokerages, all years. Do not include direct institution-to-institution transfers; they don't affect room <Fragment set:html={src("tfsa.formal_transfer")} />. Enter Canadian dollars; deposits made in another currency count at that day's exchange rate.</small>
      <label class="trc-check"><input type="checkbox" name="bestGuess" /> I'm not sure of my totals. Use my best guess.</label>
      <small class="ck-help">{HELP.bestGuess}</small>
      <p class="trc-help" data-show="guess" hidden>CRA My Account has the official record of your TFSA deposits and withdrawals, but it can be months behind: banks report last year's transactions by the end of February. Enter your best estimate here and the result will be labelled a guess.</p>
    </fieldset>

    <fieldset class="trc-step" data-step="5">
      <legend>How much did you withdraw before {CURRENT_YEAR}?</legend>
      <label>Total withdrawals up to December 31, {CURRENT_YEAR - 1} ($)
        <small class="ck-help">{HELP.priorWithdrawals}</small>
        <input type="number" name="priorWithdrawals" inputmode="numeric" min="0" step="100" placeholder="0" />
      </label>
      <p class="trc-error" data-error-for="priorWithdrawals" hidden></p>
      <p class="trc-warning" data-warning-for="priorWithdrawals" hidden></p>
      <small>All TFSAs, all years before {CURRENT_YEAR}. These came back as room on January 1 after each withdrawal, including any growth. Leave out direct transfers between institutions.</small>
    </fieldset>

    <fieldset class="trc-step" data-step="6">
      <legend>Have you withdrawn anything in {CURRENT_YEAR}?</legend>
      <label>Withdrawals so far in {CURRENT_YEAR} ($)
        <small class="ck-help">{HELP.thisYearWithdrawals}</small>
        <input type="number" name="thisYearWithdrawals" inputmode="numeric" min="0" step="100" placeholder="0" />
      </label>
      <p class="trc-error" data-error-for="thisYearWithdrawals" hidden></p>
      <p class="trc-warning" data-warning-for="thisYearWithdrawals" hidden></p>
      <small>These are not room yet. They come back on {RESTORE_DATE} <Fragment set:html={src("tfsa.withdrawal_restore")} />.</small>
      <label>Optional: a deposit you're thinking about making this year ($)
        <small class="ck-help">{HELP.plannedDeposit}</small>
        <input type="number" name="plannedDeposit" inputmode="numeric" min="0" step="100" placeholder="Leave blank to skip" />
      </label>
      <p class="trc-error" data-error-for="plannedDeposit" hidden></p>
      <p class="trc-warning" data-warning-for="plannedDeposit" hidden></p>
      <small>Including money you took out earlier this year and want to put back.</small>
    </fieldset>

    <div class="trc-nav" id="trc-nav" hidden>
      <p class="trc-count" id="trc-count" aria-live="polite">Question 1 of {TOTAL}</p>
      <div class="trc-buttons">
        <button type="button" class="trc-back" id="trc-back">Back</button>
        <button type="button" class="trc-next" id="trc-next">Next</button>
      </div>
    </div>
    <noscript><p class="trc-help">Turn on JavaScript to check your own numbers. The worked example shows how the math works.</p></noscript>
  </form>

  <div class="trc-results" id="trc-results" aria-live="polite" tabindex="-1" set:html={initialHtml} />
</div>

<Fragment set:html={renderNextSteps(fixGuideHref)} />
<Fragment set:html={renderExample()} />

<section class="trc-assumptions" aria-labelledby="trc-h-assumptions">
  <h2 id="trc-h-assumptions">How this calculator works</h2>
  <ul>
    <li><strong>Your lifetime totals are taken as entered <span class="trc-flag">estimate</span>.</strong> The result is only as accurate as those totals. It is never CRA's figure; CRA My Account has the official number, and it can lag by months <Fragment set:html={src("tfsa.my_account_lag")} />.</li>
    <li><strong>Room builds a full year's limit for each year you were 18 or older and a resident.</strong> The {CURRENT_YEAR} limit is {$(ANNUAL_LIMIT)}; someone eligible since {FIRST_TFSA_YEAR} who never contributed has {$(CUMULATIVE_MAX)} <Fragment set:html={src("tfsa.cumulative_max.2026")} />. Year-by-year limits: <Fragment set:html={src("tfsa.bands.history")} />.</li>
    <li><strong>Withdrawals come back on January 1 of the next year, never the same year</strong> <Fragment set:html={src("tfsa.withdrawal_restore")} />. The {CURRENT_YEAR + 1} annual limit is not announced yet and is left out.</li>
    <li><strong>Over-contributions are taxed at {pct(EXCESS_TAX_RATE)} a month</strong> on the highest excess in each month <Fragment set:html={src("tfsa.excess_tax")} />, reported on Form RC243 by {longDate(RC243_DEADLINE)} <Fragment set:html={src("tfsa.rc243_deadline")} />.</li>
    <li><strong>Only whole years as a non-resident remove room.</strong> Deposits made while a non-resident being taxed at {pct(EXCESS_TAX_RATE)} a month comes from a secondary source <span class="trc-flag">re-verify</span>.</li>
    <li><strong>Transfers are left out.</strong> {FORMAL_TRANSFER} <Fragment set:html={src("tfsa.formal_transfer")} />.</li>
    <li><strong>Canadian dollars only.</strong> Deposits made in another currency count at that day's exchange rate for CRA purposes; this version does not convert them.</li>
    <li><strong>Not covered here:</strong> successor holders and inherited TFSAs follow different rules (see <a href="https://www.canada.ca/en/revenue-agency/services/tax/individuals/topics/tax-free-savings-account.html" rel="noopener">CRA's TFSA pages</a>). The checker does not connect to CRA and never asks for a CRA login, and it does not model investment returns.</li>
  </ul>
  <p class="page-meta">
    This checker is education, not advice. It shows an estimate from your answers and does not tell you what to do. For your official room, see <a href={MY_ACCOUNT_URL} rel="noopener">CRA My Account</a>.
  </p>
</section>

<section class="trc-sources" aria-labelledby="trc-h-sources-list">
  <h2 id="trc-h-sources-list">Sources and dates</h2>
  <p class="page-meta">Figures from CRA pages on canada.ca, checked 2026-09-29; {CURRENT_YEAR} tax year.</p>
  <ul>
    {sources.map((s) => (
      <li>
        {s.label}: {s.source.startsWith("http") ? <a href={s.source} rel="noopener">{new URL(s.source).hostname}</a> : <span>{s.source}</span>}, verified <span class="nowrap">{s.verified_date}</span>
        {s.expires && <> (refresh due <span class="nowrap">{s.expires}</span>)</>}
      </li>
    ))}
  </ul>
</section>

<script>
  import { CURRENT_YEAR, check, validate, eligibilityStart, type CheckerInput, type Field } from "../../lib/calculators/tfsa-room-checker";
  import { renderResults, longDate } from "../../lib/calculators/tfsa-room-checker-render";
  import { track } from "../../lib/analytics";

  const CALC = "tfsa_room_checker";
  const TOTAL = 6;
  const STEP_FIELDS: Record<number, Field[]> = {
    1: ["birthYear"],
    2: ["residencyYear"],
    3: ["nonResidentYears"],
    4: ["lifetimeContributions"],
    5: ["priorWithdrawals"],
    6: ["thisYearWithdrawals", "plannedDeposit"],
  };

  const root = document.getElementById("trc");
  const form = document.getElementById("trc-form") as HTMLFormElement | null;
  const out = document.getElementById("trc-results");
  const nav = document.getElementById("trc-nav");
  const progress = document.getElementById("trc-progress");
  const count = document.getElementById("trc-count");
  const back = document.getElementById("trc-back") as HTMLButtonElement | null;
  const next = document.getElementById("trc-next") as HTMLButtonElement | null;
  const fixGuideHref = root?.dataset.fixHref ?? "/learn/tfsa";

  let current = 1;
  let reached = 1;
  let done = false;
  let started = false;
  let resultViewed = false;
  const firedOnce = new Set<string>();

  function num(fd: FormData, name: string): number | null {
    const raw = String(fd.get(name) ?? "").trim();
    if (raw === "") return null;
    const v = Number(raw);
    return Number.isFinite(v) ? v : NaN;
  }

  function read(f: HTMLFormElement): CheckerInput {
    const fd = new FormData(f);
    const residentLater = fd.get("residentLater") === "yes";
    return {
      birthYear: num(fd, "birthYear"),
      residentLater,
      residencyYear: residentLater ? num(fd, "residencyYear") : null,
      nonResidentYears: fd.getAll("nonResidentYears").map(Number),
      lifetimeContributions: num(fd, "lifetimeContributions"),
      priorWithdrawals: num(fd, "priorWithdrawals"),
      thisYearWithdrawals: num(fd, "thisYearWithdrawals"),
      plannedDeposit: num(fd, "plannedDeposit"),
      bestGuess: fd.get("bestGuess") === "on",
    };
  }

  function validBirth(i: CheckerInput): boolean {
    return i.birthYear !== null && Number.isInteger(i.birthYear) && i.birthYear >= 1900 && i.birthYear + 18 <= CURRENT_YEAR;
  }

  /** Show derived facts and hide questions that don't apply. */
  function sync(f: HTMLFormElement, i: CheckerInput) {
    const derived = f.querySelector<HTMLElement>('[data-derived="age18"]');
    if (derived) {
      const y = i.birthYear !== null && Number.isInteger(i.birthYear) ? i.birthYear + 18 : null;
      derived.textContent =
        y === null || i.birthYear! < 1900 ? "" : y <= CURRENT_YEAR ? `You turn${y < CURRENT_YEAR ? "ed" : ""} 18 in ${y}.` : `You turn 18 in ${y}.`;
    }
    f.querySelectorAll<HTMLElement>("[data-show]").forEach((el) => {
      el.hidden = el.dataset.show === "residency" ? !i.residentLater : el.dataset.show === "guess" ? !i.bestGuess : el.hidden;
    });
    const start = validBirth(i) ? eligibilityStart(i.birthYear!, i.residencyYear) : null;
    f.querySelectorAll<HTMLElement>("[data-year]").forEach((el) => {
      el.hidden = start !== null && Number(el.dataset.year) < start;
    });
  }

  function showMessages(f: HTMLFormElement, i: CheckerInput, fields: Field[]): boolean {
    const v = validate(i);
    let ok = true;
    for (const field of fields) {
      const err = f.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      const warn = f.querySelector<HTMLElement>(`[data-warning-for="${field}"]`);
      const e = v.errors[field];
      if (err) { err.textContent = e ?? ""; err.hidden = !e; }
      if (warn) { const w = v.warnings[field]; warn.textContent = w ?? ""; warn.hidden = !w; }
      if (e) ok = false;
    }
    return ok;
  }

  function allValid(i: CheckerInput): boolean {
    return Object.keys(validate(i).errors).length === 0;
  }

  function show(step: number) {
    if (!form) return;
    current = step;
    reached = Math.max(reached, step);
    form.querySelectorAll<HTMLElement>(".trc-step").forEach((el) => {
      el.classList.toggle("is-current", Number(el.dataset.step) === step);
    });
    progress?.querySelectorAll<HTMLButtonElement>("[data-goto]").forEach((b) => {
      const n = Number(b.dataset.goto);
      b.disabled = n > reached && !done;
      if (n === step) b.setAttribute("aria-current", "step");
      else b.removeAttribute("aria-current");
    });
    if (count) count.textContent = `Question ${step} of ${TOTAL}`;
    if (back) back.hidden = step === 1;
    if (next) next.textContent = step === TOTAL ? (done ? "Update my result" : "See my result") : "Next";
  }

  function focusStep(step: number) {
    form?.querySelector<HTMLElement>(`.trc-step[data-step="${step}"] input:not([type="hidden"])`)?.focus({ preventScroll: true });
  }

  function render(i: CheckerInput) {
    if (!out) return;
    const r = check(i);
    out.innerHTML = renderResults(r, { fixGuideHref, asOf: longDate(localIsoDate()) });
    if (!resultViewed) {
      resultViewed = true;
      track("calc_result_viewed", { calculator: CALC, outcome: r.outcome });
    }
  }

  function localIsoDate(): string {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  }

  function onNext() {
    if (!form) return;
    const i = read(form);
    if (!showMessages(form, i, STEP_FIELDS[current])) {
      focusStep(current);
      return;
    }
    if (current < TOTAL) {
      show(current + 1);
      focusStep(current);
      return;
    }
    // Last question: every earlier answer must still be valid.
    for (let s = 1; s <= TOTAL; s++) {
      if (!showMessages(form, i, STEP_FIELDS[s])) {
        show(s);
        focusStep(s);
        return;
      }
    }
    done = true;
    show(current);
    render(i);
    out?.focus({ preventScroll: true });
    out?.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function onUserInput(e: Event) {
    if (!started) {
      started = true;
      track("calc_started", { calculator: CALC });
    }
    const t = e.target;
    if (!(t instanceof HTMLInputElement)) return;
    if (t.name === "residentLater" && !firedOnce.has("residentLater")) {
      firedOnce.add("residentLater");
      // field rolled into the value token: 2-prop budget per event.
      track("calc_input_set", { calculator: CALC, value: `resident_later_${t.value === "yes" ? "yes" : "no"}` });
    } else if (t.name === "bestGuess" && t.checked && !firedOnce.has("bestGuess")) {
      firedOnce.add("bestGuess");
      track("calc_input_set", { calculator: CALC, value: "best_guess_on" });
    }
  }

  /** Spec: ticking every eligible year zeroes the room, so confirm first. */
  function confirmAllYears(f: HTMLFormElement, t: HTMLInputElement) {
    if (t.name !== "nonResidentYears" || !t.checked) return;
    const visible = [...f.querySelectorAll<HTMLElement>("[data-year]")].filter((el) => !el.hidden);
    const allChecked = visible.length > 0 && visible.every((el) => el.querySelector("input")?.checked);
    if (allChecked && !window.confirm("You've marked every year as a full year away from Canada. That means no TFSA room at all. Is that right?")) {
      t.checked = false;
    }
  }

  function onChange(e: Event) {
    if (!form) return;
    onUserInput(e);
    if (e.type === "change" && e.target instanceof HTMLInputElement) confirmAllYears(form, e.target);
    const i = read(form);
    sync(form, i);
    if (done) {
      showMessages(form, i, STEP_FIELDS[current]);
      if (allValid(i)) render(i);
    }
  }

  if (root && form && nav && progress) {
    root.classList.add("is-wizard");
    nav.hidden = false;
    progress.hidden = false;
    form.addEventListener("input", onChange);
    form.addEventListener("change", onChange);
    form.addEventListener("submit", (e) => { e.preventDefault(); onNext(); });
    form.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && e.target instanceof HTMLInputElement && e.target.type !== "checkbox" && e.target.type !== "radio") {
        e.preventDefault();
        onNext();
      }
    });
    next?.addEventListener("click", onNext);
    back?.addEventListener("click", () => { if (current > 1) { show(current - 1); focusStep(current); } });
    progress.addEventListener("click", (e) => {
      const b = (e.target as Element | null)?.closest<HTMLButtonElement>("[data-goto]");
      if (b && !b.disabled) { show(Number(b.dataset.goto)); focusStep(current); }
    });
    sync(form, read(form));
    show(1);
  }
</script>

<style>
  /* Same visual system as the First Home Savings Planner: a control panel on
     the left, a results statement on the right. */

  /* minmax(0, 1fr): results must not stretch the column past a 320px phone. */
  .trc { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @media (min-width: 60rem) {
    .trc { grid-template-columns: minmax(19rem, 25rem) 1fr; gap: 2rem; align-items: start; }
    .trc-results { position: sticky; top: calc(var(--header-h) + 1rem); }
  }
  .trc-results:focus { outline: none; }

  /* ---------- control panel ---------- */
  .trc-form {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
    padding: 0.5rem 1.35rem 1rem;
    counter-reset: step;
    accent-color: var(--pine-700);
  }
  .trc-form > fieldset {
    counter-increment: step;
    border: 0;
    border-top: 1px solid var(--line);
    padding: 1.25rem 0 0.5rem;
    margin: 0;
    min-width: 0;
  }
  .trc-form > fieldset:first-of-type { border-top: 0; }
  .trc-form > fieldset > legend {
    display: flex; align-items: center; gap: 0.6rem;
    float: left; width: 100%;
    font-family: var(--font-display); font-optical-sizing: auto;
    font-weight: 600; font-size: 1.12rem; color: var(--lake-900);
    padding: 0; margin: 0 0 0.35rem;
  }
  .trc-form > fieldset > legend::before {
    content: counter(step);
    flex: none;
    width: 1.6rem; height: 1.6rem; border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--font-body); font-size: 0.78rem; font-weight: 700;
    background: var(--lake-900); color: var(--gold-bright);
  }
  .trc-form > fieldset > legend + * { clear: both; }

  .trc-form label { display: block; font-size: 0.92rem; font-weight: 600; margin: 0.85rem 0; color: var(--ink); clear: both; }
  .trc-form label[hidden], .trc-form [hidden] { display: none !important; }
  .trc-form input[type="number"] {
    display: block; width: 100%; margin-top: 0.35rem; padding: 0.65rem 0.8rem;
    font: inherit; font-weight: 500; font-size: 1rem; font-variant-numeric: tabular-nums;
    color: var(--ink);
    border: 1px solid var(--line-strong); border-radius: 10px;
    background: var(--paper);
    min-height: 2.9rem;
    transition: border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
  }
  .trc-form input:hover { border-color: var(--pine-500); }
  .trc-form input[type="number"]:focus-visible {
    outline: none;
    background: var(--card);
    border-color: var(--pine-700);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gold) 55%, transparent);
  }
  .trc-form small, .trc-help { display: block; font-weight: 400; color: var(--ink-soft); font-size: 0.8rem; line-height: 1.45; margin: 0.35rem 0 0; }
  .trc-help { font-size: 0.86rem; margin: 0.5rem 0; }
  .trc-derived { margin: 0.25rem 0; font-size: 0.9rem; font-weight: 600; color: var(--pine-700); }
  .trc-derived:empty { display: none; }
  .trc-error, .trc-warning { margin: 0.35rem 0; font-size: 0.86rem; font-weight: 600; }
  .trc-error { color: var(--danger); }
  .trc-warning { color: var(--gold-deep); }

  .trc-radio, .trc-check { font-weight: 450 !important; display: flex !important; gap: 0.6rem; align-items: flex-start; line-height: 1.45; cursor: pointer; }
  .trc-radio input, .trc-check input { margin: 0.12rem 0 0; width: 1.15rem; height: 1.15rem; flex: none; }
  .trc-form .trc-radio {
