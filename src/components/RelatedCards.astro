---
/**
 * Related-cards block, generated from the front-matter `related` array.
 * Only pages that exist in this build render as cards (live first, short
 * `card_dek` text). Unbuilt pages are hidden entirely.
 */
import { pageBySlug } from "../lib/site";

interface Props {
  slugs: string[];
  heading?: string;
  builtSlugs: Set<string>;
}

const { slugs, heading = "Keep reading", builtSlugs } = Astro.props;
const cards = slugs
  .map((s) => pageBySlug.get(s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const live = cards.filter((p) => builtSlugs.has(p.slug));

const kindOf = (slug: string) =>
  slug.startsWith("/learn/") ? "Explainer" : slug.startsWith("/compare/") ? "Comparison" : slug.startsWith("/calculators/") ? "Tool" : "Page";
---

{
  live.length > 0 && (
    <section class="related-cards" aria-label={heading}>
      <p class="eyebrow">Next up</p>
      <h2>{heading}</h2>
      {live.length > 0 && (
        <div class="card-grid">
          {live.map((p) => (
            <article class="card is-linked">
              <p class="card-eyebrow">{kindOf(p.slug)}</p>
              <h3><a href={p.slug}>{p.title}</a></h3>
              <p class="dek">{p.card_dek ?? p.meta_description}</p>
              <div class="card-foot"><span class="go" aria-hidden="true">Read →</span></div>
            </article>
          ))}
        </div>
      )}
    </section>
  )
}
