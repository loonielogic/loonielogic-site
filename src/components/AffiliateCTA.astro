---
/**
 * AffiliateCTA — the single component editors use for monetized CTAs.
 * Per hidden_files/affiliate-link-implementation-spec.md:
 * - Live records → /go/<merchant>/ href with rel="sponsored noopener" and an
 *   "(affiliate link)" marker on the button.
 * - Anything below live (all 5 records are `pending` at scaffold) → honest
 *   placeholder: the same button styling as a non-navigating element, with
 *   micro-copy saying the affiliate link goes here once approved. The
 *   merchant's plain homepage gets wired in when the first real CTA ships
 *   (the record carries no confirmed homepage URL at scaffold, and we do not
 *   guess URLs). No tracking params, no invented UTMs, no leaked tokens.
 */
import affiliateRecords from "../data/affiliates-index.json";

interface Props {
  merchant: string;
  position: string;
  label: string;
  src: string;
}

const { merchant, position, label, src } = Astro.props;
const record = (affiliateRecords as Record<string, {
  display_name: string;
  homepage: string | null;
  status: string;
}>)?.[merchant];

if (!record) {
  throw new Error(`AffiliateCTA: unknown merchant "${merchant}"`);
}

const isLive = record.status === "live";
const href = isLive
  ? `/go/${merchant}/?src=${encodeURIComponent(src)}&pos=${encodeURIComponent(position)}&v=1`
  : null; // placeholder: no destination until the program is live
---

<div class="affiliate-cta">
  {isLive ? (
    <a class="btn btn-gold" href={href} rel="sponsored noopener">
      {label}
      <span class="sponsored-marker"> (affiliate link)</span>
    </a>
  ) : (
    <span class="btn btn-gold" aria-disabled="true" role="link">
      {label}
    </span>
    <p class="micro">
      Affiliate link goes here once our application is approved.
    </p>
  )}
</div>
