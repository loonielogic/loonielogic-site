---
/**
 * ComparisonDisclosure — the disclosure bar for /compare/* pages.
 * Per hidden_files/affiliate-link-implementation-spec.md §4:
 * - Pages with live affiliate links → the short above-the-fold disclosure.
 * - Pages with zero live links (e.g. TFSA vs RRSP at scaffold) → the explicit
 *   non-affiliate line, NOT the commission disclosure (disclosing commissions
 *   a page cannot earn is a misleading impression in reverse).
 */
interface Props {
  hasLiveLinks: boolean;
}

const { hasLiveLinks } = Astro.props;
---

<div class="disclosure-bar" role="note">
  {hasLiveLinks ? (
    <p>
      <strong>Heads up:</strong> some links on this page are affiliate links.
      If you sign up through them, we may earn a commission at no extra cost to
      you. Commissions never change our math or our recommendations. Full
      details on our{" "}
      <a href="/affiliate-disclosure">affiliate disclosure page</a>.
    </p>
  ) : (
    <p>
      <strong>No affiliate links here:</strong> we don't earn anything from the
      links on this page. There's no affiliate program for these providers we
      can use honestly yet.
    </p>
  )}
</div>
