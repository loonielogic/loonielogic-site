---
/**
 * HubPage — generated hub template (hub-page-templates-spec.md).
 * Card data comes from src/data/sitemap.json; `builtSlugs` marks which pages
 * actually exist in this build. Only live pages render as cards (using the
 * short `card_dek`, falling back to meta_description). Pages that are built
 * but still in draft review (`inReview`) get their own unlinked list with
 * their short descriptor; anything else not yet built collapses into one
 * plain "Coming next" list, so nothing looks live that isn't (hub renders
 * only published cards per spec §7).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import NewsletterCapture from "./NewsletterCapture.astro";
import type { SitemapPage } from "../lib/site";
import type { NewsletterPlacementToken } from "../config/newsletter";

interface CardMeta {
  chips?: string[];
  badge?: string;
  verdict?: string;
}

interface Props {
  slug: string;
  title: string;
  metaDescription: string;
  h1: string;
  intro: string;
  breadcrumb: string;
  cards: SitemapPage[];
  builtSlugs: Set<string>;
  cardMeta?: Record<string, CardMeta>;
  groups?: { label: string; slugs: string[] }[];
  cta: { label: string; href: string };
  disclosureBlock?: boolean;
  /** Small label above the H1. */
  eyebrow?: string;
  /** One line of copy beside the closing CTA button. */
  ctaLead?: string;
  /** Footer-adjacent compact newsletter form, e.g. "learn_hub". */
  newsletterPlacement?: NewsletterPlacementToken;
  /** Built pages still in draft review: listed (unlinked) instead of "Coming next". */
  inReview?: Set<string>;
  /** When true, unbuilt pages are hidden entirely instead of a "Coming next" list. */
  hideUpcoming?: boolean;
  /** Heading and one-line note for the draft-review list. */
  inReviewHeading?: string;
  inReviewNote?: string;
}

const {
  slug, title, metaDescription, h1, intro, breadcrumb, cards, builtSlugs,
  cardMeta = {}, groups, cta, disclosureBlock = false, eyebrow = breadcrumb,
  ctaLead = "Ready for the next step?", newsletterPlacement,
  inReview = new Set<string>(), inReviewHeading = "In draft review",
  inReviewNote = "Built and being double-checked against official sources before they are published.",
  hideUpcoming = false,
} = Astro.props;

const bySlug = new Map(cards.map((c) => [c.slug, c]));
const live = cards.filter((c) => builtSlugs.has(c.slug));
const reviewing = cards.filter((c) => !builtSlugs.has(c.slug) && inReview.has(c.slug));
const upcoming = cards.filter((c) => !builtSlugs.has(c.slug) && !inReview.has(c.slug));

// Grouped hubs keep their sections, but a section only appears once it has
// at least one live page.
const grouped = groups
  ? groups
      .map((g) => ({
        ...g,
        cards: g.slugs
          .map((s) => bySlug.get(s))
          .filter((c): c is SitemapPage => Boolean(c) && builtSlugs.has(c!.slug)),
      }))
      .filter((g) => g.cards.length > 0)
  : null;
const sections = grouped ?? (live.length > 0 ? [{ label: null, cards: live }] : []);

// Analytics tokens: hub from the page slug ("/learn/" -> "learn"), card from the
// card slug ("/learn/tfsa" -> "learn_tfsa"). Hyphens become underscores so the
// values pass the analytics class-token check (no raw text or numbers leave).
const hubToken = slug.replace(/\//g, "") || "home";
const cardToken = (s: string) => s.replace(/^\//, "").replace(/[^a-z0-9]+/g, "_");

// The trailing arrow is drawn by the button itself.
const ctaText = cta.label.replace(/\s*→\s*$/, "");
---

<BaseLayout
  title={title}
  metaDescription={metaDescription}
  slug={slug}
  pageType="hub"
  breadcrumbs={[{ name: breadcrumb, slug }]}
>
  <section class="page-hero page-hero-light hub-hero">
    <div class="wrap">
      <Breadcrumbs trail={[{ name: breadcrumb, slug }]} />
      <p class="eyebrow">{eyebrow}</p>
      <h1>{h1}</h1>
      <p class="lede">{intro}</p>
      {live.length + reviewing.length + upcoming.length > 0 && (
        <p class="hub-count">
          {[
            live.length > 0 && <><strong>{live.length}</strong> published</>,
            reviewing.length > 0 && <><strong>{reviewing.length}</strong> in draft review</>,
            upcoming.length > 0 && <><strong>{upcoming.length}</strong> in progress</>,
          ]
            .filter(Boolean)
            .map((part, k) => <>{k > 0 && " · "}{part}</>)}
        </p>
      )}
    </div>
  </section>

  <div class="wrap">
    {disclosureBlock && (
      <div class="disclosure-bar" role="note">
        <p>
          <em>
            We may earn a commission when you sign up for products through
            links on this page, at no extra cost to you. We disclose this on
            every comparison page too.{" "}
            <a href="/affiliate-disclosure">Read our affiliate disclosure</a>.
          </em>
        </p>
      </div>
    )}

    {sections.map((g) => (
      <section class="hub-section" aria-label={g.label ?? "Live now"}>
        {g.label && <h2 class="hub-label">{g.label}</h2>}
        <div class="card-grid">
          {g.cards.map((p) => {
            const meta = cardMeta[p.slug] ?? {};
            return (
              <article class="card is-linked">
                <h3>
                  <a
                    href={p.slug}
                    data-analytics-event="hub_card_clicked"
                    data-analytics-hub={hubToken}
                    data-analytics-card={cardToken(p.slug)}
                  >{p.title}</a>
                </h3>
                <p class="dek">{p.card_dek ?? p.meta_description}</p>
                {(meta.chips || meta.badge) && (
                  <div class="chips">
                    {meta.badge && <span class="chip chip-badge">{meta.badge}</span>}
                    {(meta.chips ?? []).map((c) => <span class="chip">{c}</span>)}
                  </div>
                )}
                {meta.verdict && <p class="verdict"><strong>Verdict:</strong> {meta.verdict}</p>}
                <div class="card-foot"><span class="go" aria-hidden="true">Read →</span></div>
              </article>
            );
          })}
        </div>
      </section>
    ))}

    {reviewing.length > 0 && (
      <section class="coming-next in-review" aria-labelledby="hub-in-review">
        <h2 id="hub-in-review">{inReviewHeading}</h2>
        <p class="page-meta">{inReviewNote}</p>
        <ul>
          {reviewing.map((p) => (
            <li><strong>{p.title}</strong><span>{p.card_dek ?? p.meta_description}</span></li>
          ))}
        </ul>
      </section>
    )}

    {upcoming.length > 0 && !hideUpcoming && (
      <section class="coming-next" aria-label="Coming next">
        <h2>Coming next</h2>
        <p class="page-meta">Not published yet. These pages are in progress:</p>
        <ul>
          {upcoming.map((p) => <li>{p.title}</li>)}
        </ul>
      </section>
    )}

    <div class="cta-band">
      <p>{ctaLead}</p>
      <a class="btn btn-gold" href={cta.href}>{ctaText} <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    {newsletterPlacement && (
      <div class="hub-newsletter">
        <NewsletterCapture variant="compact" placement={newsletterPlacement} />
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .hub-hero { padding-bottom: clamp(2.5rem, 6vw, 3.75rem); }
  .hub-hero h1 { max-width: 22ch; }
  .hub-count { margin: 1.5rem 0 0; font-size: 0.9rem; color: var(--ink-soft); }
  .hub-count strong { font-family: var(--font-display); font-size: 1.2rem; color: var(--lake-900); }
  .hub-section { margin-top: 3rem; }
  .hub-label {
    display: flex; align-items: center; gap: 1rem;
    font-size: 1.5rem; margin: 0 0 0.25rem;
  }
  .hub-label::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  .in-review li { display: flex; flex-direction: column; gap: 0.15rem; padding-bottom: 0.4rem; }
  .in-review li strong { color: var(--lake-900); font-weight: 600; }
  .hub-newsletter { margin: 2.5rem 0 clamp(3rem, 7vw, 4.5rem); }
</style>
