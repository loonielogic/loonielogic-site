---
/**
 * /calculators/rrsp-room: the RRSP contribution room calculator
 * (Mode A from the NOA, Mode B rebuild). Page metadata comes from the
 * calculator manifest (src/data/calculator-manifests.json). The manifest
 * status is still "draft", so the page is built but marked noindex and stays
 * off the calculators hub and sitemap.xml until it is published.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedCards from "../../components/RelatedCards.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import RrspRoom from "../../components/calculators/RrspRoom.astro";
import { getCollection } from "astro:content";
import manifests from "../../data/calculator-manifests.json";
import { canonicalUrl } from "../../lib/site";

const SLUG = "/calculators/rrsp-room";
const NAME = "RRSP Room Calculator";
const m = manifests.manifests.find((x) => x.slug === SLUG)!;

const builtSlugs = new Set<string>(["/", "/learn/", "/calculators/", "/compare/"]);
for (const coll of ["explainers", "comparisons", "legal"] as const) {
  for (const e of await getCollection(coll)) builtSlugs.add(e.data.slug);
}

const webApp = {
  "@type": "WebApplication",
  name: "RRSP Contribution Room Calculator 2026",
  url: canonicalUrl(SLUG),
  applicationCategory: "FinanceApplication",
  operatingSystem: "Any",
  inLanguage: "en-CA",
  offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
};
---

<BaseLayout
  title={m.title}
  metaDescription={m.meta_description}
  slug={SLUG}
  pageType="calculator"
  dateModified={m.last_reviewed}
  noindex={m.status !== "live"}
  jsonLdExtra={webApp}
  breadcrumbs={[{ name: "Tools", slug: "/calculators/" }, { name: NAME, slug: SLUG }]}
>
  <section class="page-hero checker-hero">
    <div class="wrap">
      <Breadcrumbs trail={[{ name: "Tools", slug: "/calculators/" }, { name: NAME, slug: SLUG }]} />
      <div class="checker-tags">
        <p class="eyebrow">Tools · Retirement</p>
        {m.status !== "live" && <span class="chip chip-draft">Draft</span>}
      </div>
      <h1>RRSP Contribution Room Calculator</h1>
      <p class="lede">
        Find out how much you can still put in your RRSP this year without going over. Start from the deduction limit on your Notice of Assessment, or rebuild it from CRA's formula, then subtract what has gone in since. The tool flags the traps that cause over-contributions: the first 60 days, group and spousal RRSPs, and the $2,000 cushion.
      </p>
      <p class="page-meta checker-meta">
        <span>Last reviewed: <time datetime={m.last_reviewed}>{m.last_reviewed}</time></span>
        <span>Two modes: your NOA or a rebuild</span>
        <span>An estimate from your records, not CRA's figure.</span>
      </p>
    </div>
  </section>

  <div class="wrap checker-body">
    <RrspRoom />

    <RelatedCards slugs={m.related} builtSlugs={builtSlugs} />
  </div>
</BaseLayout>

<style>
  .checker-hero { padding-bottom: clamp(4.5rem, 9vw, 6.5rem); }
  .checker-hero h1 { max-width: 18ch; font-size: clamp(2.4rem, 6vw, 4.2rem); line-height: 1; letter-spacing: -0.03em; }
  .checker-hero .lede { max-width: 46rem; }
  .checker-tags { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 1rem; }
  .checker-tags .eyebrow { margin: 0; }
  .checker-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin: 1.5rem 0 0; }
  .checker-meta span + span::before { content: "·"; margin-right: 1.25rem; color: var(--gold-bright); }
  @media (max-width: 40rem) { .checker-meta span + span::before { display: none; } .checker-meta { flex-direction: column; } }
  .checker-body { position: relative; margin-top: clamp(-4rem, -6vw, -2.5rem); }
</style>
