---
/**
 * /calculators/tfsa-room-checker: the TFSA Over-Contribution Risk Checker.
 * Page metadata comes from the calculator manifest
 * (src/data/calculator-manifests.json). The manifest status is still
 * "draft", so the page is built but marked noindex and stays off the
 * calculators hub and sitemap.xml until it is published.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedCards from "../../components/RelatedCards.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TfsaRoomChecker from "../../components/calculators/TfsaRoomChecker.astro";
import { getCollection } from "astro:content";
import manifests from "../../data/calculator-manifests.json";
import { canonicalUrl } from "../../lib/site";
import { tfsaFigures } from "../../lib/calculators/tfsa-room-checker";

const SLUG = "/calculators/tfsa-room-checker";
const FIX_GUIDE = "/learn/tfsa-overcontribution-fix";
const m = manifests.manifests.find((x) => x.slug === SLUG)!;

const builtSlugs = new Set<string>(["/", "/learn/", "/calculators/", "/compare/"]);
for (const coll of ["explainers", "comparisons", "legal"] as const) {
  for (const e of await getCollection(coll)) builtSlugs.add(e.data.slug);
}
// Until the site's fix guide is published, over-contribution links go to CRA's excess-tax page.
const fixGuideHref = builtSlugs.has(FIX_GUIDE) ? FIX_GUIDE : tfsaFigures.get("tfsa.excess_tax")!.source;

const webApp = {
  "@type": "WebApplication",
  name: "TFSA Over-Contribution Risk Checker",
  url: canonicalUrl(SLUG),
  applicationCategory: "FinanceApplication",
  operatingSystem: "Any",
  inLanguage: "en-CA",
  offers: { "@type": "Offer", price: "0", priceCurrency: "CAD" },
};
---

<BaseLayout
  title={m.title}
  metaDescription={m.meta_description}
  slug={SLUG}
  pageType="calculator"
  dateModified={m.last_reviewed}
  noindex={m.status !== "live"}
  jsonLdExtra={webApp}
  breadcrumbs={[{ name: "Tools", slug: "/calculators/" }, { name: "TFSA Risk Checker", slug: SLUG }]}
>
  <section class="page-hero checker-hero">
    <div class="wrap">
      <Breadcrumbs trail={[{ name: "Tools", slug: "/calculators/" }, { name: "TFSA Risk Checker", slug: SLUG }]} />
      <div class="checker-tags">
        <p class="eyebrow">Tools · TFSA</p>
      </div>
      <h1>TFSA Over-Contribution Risk Checker</h1>
      <p class="lede">
        Can you still contribute this year without over-contributing? Six questions give an estimate of
        your TFSA room right now and the room that comes back on January 1. The checker flags the two
        traps behind most over-contributions: putting a same-year withdrawal back in, and room that has
        already gone below zero.
      </p>
      <p class="page-meta checker-meta">
        <span>Last reviewed: <time datetime={m.last_reviewed}>{m.last_reviewed}</time></span>
        <span>2026 tax year</span>
        <span>Educational only: an estimate from your records, not CRA's figure.</span>
      </p>
    </div>
  </section>

  <div class="wrap checker-body">
    <TfsaRoomChecker fixGuideHref={fixGuideHref} />

    <RelatedCards slugs={m.related} builtSlugs={builtSlugs} />
  </div>
</BaseLayout>

<style>
  .checker-hero { padding-bottom: clamp(4.5rem, 9vw, 6.5rem); }
  .checker-hero h1 { max-width: 18ch; font-size: clamp(2.4rem, 6vw, 4.2rem); line-height: 1; letter-spacing: -0.03em; }
  .checker-hero .lede { max-width: 46rem; }
  .checker-tags { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 1rem; }
  .checker-tags .eyebrow { margin: 0; }
  .checker-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin: 1.5rem 0 0; }
  .checker-meta span + span::before { content: "·"; margin-right: 1.25rem; color: var(--gold-bright); }
  @media (max-width: 40rem) { .checker-meta span + span::before { display: none; } .checker-meta { flex-direction: column; } }
  .checker-body { position: relative; margin-top: clamp(-4rem, -6vw, -2.5rem); }
</style>
