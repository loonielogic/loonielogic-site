---
import HubPage from "../../components/HubPage.astro";
import { sectionPages } from "../../lib/site";

// Several calculator shells are built, but every manifest is still "draft"
// (noindex, off sitemap.xml), so no tool is linked from the hub yet: every
// card lands in the "in progress" list until the founder publishes it.
const cards = sectionPages("/calculators/");

const cardMeta = {
  "/calculators/income-tax-calculator": { badge: "Flagship: start here", chips: ["13 provinces", "paycheque mode"] },
  "/calculators/tfsa-vs-rrsp": { chips: ["6 questions", "verdict"] },
  "/calculators/house-affordability": { chips: ["GDS 39%", "TDS 44%"] },
  "/calculators/down-payment-planner": { chips: ["FHSA + HBP stack"] },
  "/calculators/rent-vs-buy": { chips: ["breakeven year", "net wealth"] },
  "/calculators/compound-growth": { chips: ["wealth over time", "start early"] },
  "/calculators/goal-planner": { chips: ["set the goal", "find the path"] },
  "/calculators/tfsa-room-checker": { chips: ["$109,000 max lookup"] },
  "/calculators/rrsp-room": { chips: ["dual mode", "$2,000 buffer"] },
  "/calculators/cpp-timing": { chips: ["60 vs 65 vs 70", "breakeven ages"] },
};
---

<HubPage
  slug="/calculators/"
  title="Canadian Tax & Savings Calculators 2026 | LoonieLogic"
  metaDescription="Canadian money calculators in progress: income tax, TFSA vs RRSP, room trackers, and home buying. Until they launch, our guides show the math by hand."
  h1="Calculators that do real Canadian math"
  intro="Five calculators are built and in draft review while we double-check the math: the First Home Savings Planner, the TFSA Over-Contribution Risk Checker, the CPP Timing Calculator, Wealth Over Time (compound growth), and the Goal Planner. The income tax calculator, TFSA vs RRSP, RRSP room, house affordability, and rent vs buy tools are still in progress. Until they launch, the TFSA vs RRSP comparison walks through the 2026 math by hand, with worked examples and a clear verdict."
  breadcrumb="Tools"
  cards={cards}
  builtSlugs={new Set()}
  cardMeta={cardMeta}
  eyebrow="Tools · Calculators"
  ctaLead="Until the calculators launch, the math is worked by hand."
  cta={{ label: "See the math now: TFSA vs RRSP →", href: "/compare/tfsa-vs-rrsp" }}
  newsletterPlacement="calculators_hub"
/>
