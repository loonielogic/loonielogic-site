---
/**
 * Root legal renderer — /about, /privacy, /affiliate-disclosure, /terms.
 * Legal slugs are root-level per the canonical sitemap. Static files always
 * win over this dynamic route, so future hand-built root pages take priority.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleShell from "../components/ArticleShell.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const legal = await getCollection("legal");
  return legal.map((e) => ({
    params: { slug: e.data.slug.replace(/^\//, "") },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
---

<BaseLayout
  title={d.title}
  metaDescription={d.meta_description}
  slug={d.slug}
  pageType={d.page_type}
  dateModified={d.last_reviewed}
  breadcrumbs={[{ name: d.title, slug: d.slug }]}
>
  <ArticleShell
    eyebrow={d.slug === "/about" ? "About LoonieLogic" : "The fine print, in plain English"}
    title={d.title}
    lastReviewed={String(d.last_reviewed)}
    reviewCadence={d.review_cadence}
    trail={[{ name: d.title, slug: d.slug }]}
    headings={headings}
    variant="legal"
    honestyFoot={false}
  >
    <Content />
  </ArticleShell>
</BaseLayout>
