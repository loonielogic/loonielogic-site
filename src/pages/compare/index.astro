---
import HubPage from "../../components/HubPage.astro";
import { sectionPages } from "../../lib/site";
import { getCollection } from "astro:content";

const cards = sectionPages("/compare/");
const comparisons = await getCollection("comparisons");
const builtSlugs = new Set(comparisons.map((e) => e.data.slug));

const cardMeta = {
  "/compare/tfsa-vs-rrsp": { verdict: "The only comparison that recommends. No affiliate links on this page." },
  "/compare/wealthsimple-vs-questrade": { verdict: "Wealthsimple default for most beginners; Questrade wins for US-heavy investors." },
  "/compare/fhsa-vs-home-buyers-plan": { verdict: "FHSA first, HBP second, stack both." },
  "/compare/best-bank-accounts-beginners": { verdict: "EQ Bank default; 2.75% vs $0.50/yr." },
};
---

<HubPage
  slug="/compare/"
  title="TFSA vs RRSP, Brokerages & Banks Compared | LoonieLogic"
  metaDescription="Honest Canadian comparisons with verdicts: TFSA vs RRSP, Wealthsimple vs Questrade, FHSA vs Home Buyers' Plan, and the best beginner bank accounts."
  h1="Comparisons that actually recommend"
  intro="Four head-to-heads where we say which one to pick — and show the math. Most Canadian finance sites describe your options and leave you to guess. We don't."
  breadcrumb="Compare"
  cards={cards}
  builtSlugs={builtSlugs}
  cardMeta={cardMeta}
  disclosureBlock={true}
  cta={{ label: "Get the rules behind the verdicts — read the explainers →", href: "/learn/" }}
/>
