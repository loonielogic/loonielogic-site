---
/**
 * Explainer renderer — /learn/*. One H1 from the title, "Last reviewed"
 * stamp (must match schema dateModified), related cards from front matter.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedCards from "../../components/RelatedCards.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const explainers = await getCollection("explainers");
  return explainers.map((e) => ({
    params: { slug: e.data.slug.replace("/learn/", "") },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Pages that actually exist in this build — related cards link only to
// these; everything else renders "Coming soon" (no dead links).
const builtSlugs = new Set<string>(["/", "/learn/", "/calculators/", "/compare/"]);
for (const coll of ["explainers", "comparisons", "legal"] as const) {
  for (const e of await getCollection(coll)) builtSlugs.add(e.data.slug);
}
---

<BaseLayout
  title={d.title}
  metaDescription={d.meta_description}
  slug={d.slug}
  pageType={d.page_type}
  dateModified={d.last_reviewed}
  breadcrumbs={[{ name: "Learn", slug: "/learn/" }, { name: d.title, slug: d.slug }]}
>
  <div class="wrap">
    <nav aria-label="Breadcrumb" class="page-meta" style="margin-top:1.5rem">
      <a href="/">Home</a> › <a href="/learn/">Learn</a> › {d.title}
    </nav>
    <article class="prose">
      <h1>{d.title}</h1>
      <p class="page-meta">
        Last reviewed: {d.last_reviewed} · {d.review_cadence} review
      </p>
      <Content />
    </article>
    <RelatedCards slugs={d.related} builtSlugs={builtSlugs} />
  </div>
</BaseLayout>
