---
/**
 * Explainer renderer — /learn/*. One H1 from the title, "Last reviewed"
 * stamp (must match schema dateModified), related cards from front matter.
 * Layout and reading chrome live in ArticleShell.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleShell from "../../components/ArticleShell.astro";
import RelatedCards from "../../components/RelatedCards.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const explainers = await getCollection("explainers");
  return explainers.map((e) => ({
    params: { slug: e.data.slug.replace("/learn/", "") },
    props: { entry: e },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

// Pages that actually exist in this build — related cards link only to
// these; everything else renders "Coming soon" (no dead links).
const builtSlugs = new Set<string>(["/", "/learn/", "/calculators/", "/compare/"]);
for (const coll of ["explainers", "comparisons", "legal"] as const) {
  for (const e of await getCollection(coll)) builtSlugs.add(e.data.slug);
}
---

<BaseLayout
  title={d.title}
  metaDescription={d.meta_description}
  slug={d.slug}
  pageType={d.page_type}
  dateModified={d.last_reviewed}
  noindex={d.status !== "live"}
  breadcrumbs={[{ name: "Learn", slug: "/learn/" }, { name: d.title, slug: d.slug }]}
  readingProgress
>
  <ArticleShell
    eyebrow={d.page_type === "glossary" ? "Learn · Reference" : "Learn · Explainer"}
    title={d.title}
    lastReviewed={String(d.last_reviewed)}
    reviewCadence={d.review_cadence}
    trail={[{ name: "Learn", slug: "/learn/" }, { name: d.title, slug: d.slug }]}
    headings={headings}
    body={entry.body}
    newsletter={d.newsletter_placement}
  >
    <Content />
    <RelatedCards slot="below" slugs={d.related} builtSlugs={builtSlugs} />
  </ArticleShell>
</BaseLayout>
