---
/**
 * BaseLayout — shared chrome for every LoonieLogic page.
 * Content pages carry no client JS beyond the small Tools-dropdown script
 * (open/close state, aria-expanded, Escape). JSON-LD per page_type per the
 * SEO technical spec §1.
 */
import "../styles/global.css";
import { canonicalUrl, SITE_URL, DEFAULT_OG_IMAGE, WEBFONT_CSS } from "../lib/site";
import { loonMarkSvg, loonFaviconHref } from "../lib/loon-mark";
import {
  CF_BEACON_SCRIPT_SRC,
  CF_BEACON_TOKEN,
  UMAMI_SCRIPT_SRC,
  UMAMI_WEBSITE_ID,
  isCfBeaconEnabled,
  isUmamiEnabled,
} from "../lib/analytics";
import { ogImageFor, OG_WIDTH, OG_HEIGHT } from "../lib/og";
import { TOOL_GROUPS } from "../lib/tools-nav";

interface Crumb {
  name: string;
  slug: string;
}

interface Props {
  title: string;
  metaDescription: string;
  slug: string;
  pageType: string;
  dateModified?: string;
  jsonLdExtra?: Record<string, unknown>;
  noindex?: boolean;
  /** Absolute URL override; defaults to the page's share card, then the loon avatar. */
  ogImage?: string;
  /** Trail below Home, ending with the current page. Emits BreadcrumbList. */
  breadcrumbs?: Crumb[];
  /** Show the CSS-only reading-progress rule under the header (long reads). */
  readingProgress?: boolean;
}

const {
  title,
  metaDescription,
  slug,
  pageType,
  dateModified,
  jsonLdExtra,
  noindex = false,
  ogImage,
  breadcrumbs,
  readingProgress = false,
} = Astro.props;

const navItems = [
  { href: "/learn/", label: "Learn" },
  { href: "/calculators/", label: "Tools" },
  { href: "/compare/", label: "Compare" },
  { href: "/about", label: "About" },
];
const sectionOf = (href: string) => href.replace(/\/$/, "");
function current(href: string): "page" | "true" | undefined {
  if (slug === href) return "page";
  return slug.startsWith(sectionOf(href) + "/") ? "true" : undefined;
}
const year = new Date().getFullYear();

const canonical = canonicalUrl(slug);

// Share image: an explicit override, else the page's 1200x630 card
// (src/lib/og.ts, rendered by `npm run og`), else the square loon avatar.
const card = ogImage ? undefined : ogImageFor(slug);
const shareImage = ogImage ?? (card ? `${SITE_URL}${card.image}` : DEFAULT_OG_IMAGE);
const shareAlt = card?.alt ?? "LoonieLogic logo: a gold common loon in a coin-style ring";
const ogType = ["explainer", "comparison"].includes(pageType) ? "article" : "website";
const today = new Date().toISOString().slice(0, 10);
const modified = dateModified ?? today;

// Umami Cloud (cookieless analytics). Snippet renders only while the kill
// switch is on; the website ID is the only per-environment value.
const umamiOrigin = new URL(UMAMI_SCRIPT_SRC).origin;

const baseNodes: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    name: "LoonieLogic",
    url: `${SITE_URL}/`,
    inLanguage: "en-CA",
  },
  {
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    name: "LoonieLogic",
    url: `${SITE_URL}/`,
  },
];

const primaryType: Record<string, unknown> =
  pageType === "home"
    ? { "@type": "WebPage", name: title, url: canonical }
    : pageType === "hub"
      ? {
          "@type": "CollectionPage",
          name: title,
          url: canonical,
          inLanguage: "en-CA",
          dateModified: modified,
        }
      : pageType === "glossary" || pageType === "page"
        ? {
            "@type": "WebPage",
            name: title,
            url: canonical,
            inLanguage: "en-CA",
            dateModified: modified,
          }
        : {
            "@type": "Article",
            headline: title,
            url: canonical,
            inLanguage: "en-CA",
            author: { "@type": "Organization", name: "LoonieLogic" },
            dateModified: modified,
            articleSection: pageType === "comparison" ? "Compare" : "Learn",
          };

const breadcrumbNode: Record<string, unknown>[] =
  breadcrumbs && breadcrumbs.length > 0
    ? [
        {
          "@type": "BreadcrumbList",
          itemListElement: [{ name: "Home", slug: "/" }, ...breadcrumbs].map((c, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: c.name,
            item: canonicalUrl(c.slug),
          })),
        },
      ]
    : [];

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    ...baseNodes,
    primaryType,
    ...breadcrumbNode,
    ...(jsonLdExtra ? [jsonLdExtra] : []),
  ],
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="LoonieLogic" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    {card && <meta property="og:image:width" content={String(OG_WIDTH)} />}
    {card && <meta property="og:image:height" content={String(OG_HEIGHT)} />}
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content={card ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={WEBFONT_CSS} rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={loonFaviconHref} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1f1c" />
    {isUmamiEnabled && (
      <>
        <link rel="preconnect" href={umamiOrigin} />
        <script defer src={UMAMI_SCRIPT_SRC} data-website-id={UMAMI_WEBSITE_ID}></script>
        <script>
          import { bindClickTracking } from "../lib/analytics";
          bindClickTracking();
        </script>
      </>
    )}
    {isCfBeaconEnabled && (
      /* Cloudflare Web Analytics snippet, verbatim from the dashboard. */
      <script
        type="module"
        src={CF_BEACON_SCRIPT_SRC}
        data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}
      ></script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="LoonieLogic home">
          <Fragment set:html={loonMarkSvg({ size: 32 })} />
          <span class="wordmark" aria-hidden="true">Loonie<em>Logic</em></span>
        </a>
        <nav class="main-nav" aria-label="Primary">
          {navItems.map((n) =>
            n.href === "/calculators/" ? (
              <div class="nav-tools" data-nav-tools>
                <a href={n.href} aria-current={current(n.href)}>{n.label}</a>
                <button
                  type="button"
                  class="nav-tools-toggle"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="tools-menu"
                  aria-label="Show all tools"
                >
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <div class="tools-menu" id="tools-menu" hidden>
                  {TOOL_GROUPS.map((g) => (
                    <div class="tools-group">
                      <p class="tools-group-label" id={`tools-${g.label.replace(/\W+/g, "-").toLowerCase()}`}>{g.label}</p>
                      <ul aria-labelledby={`tools-${g.label.replace(/\W+/g, "-").toLowerCase()}`}>
                        {g.tools.map((t) => (
                          <li>
                            <a href={t.slug} aria-current={slug === t.slug ? "page" : undefined}>
                              <span class="tools-name">{t.name}</span>
                              <span class="tools-desc">{t.descriptor}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  <a class="tools-all" href="/calculators/">All tools <span aria-hidden="true">→</span></a>
                </div>
              </div>
            ) : (
              <a href={n.href} aria-current={current(n.href)}>{n.label}</a>
            ),
          )}
        </nav>
      </div>
      {readingProgress && <div class="read-progress" aria-hidden="true"></div>}
    </header>

    <script>
      // Tools dropdown: opens on hover (fine pointers), keyboard focus, or a tap
      // on the toggle; closes on Escape, focus leaving, a click outside, or the
      // pointer leaving. The "Tools" label itself stays a plain link.
      for (const root of document.querySelectorAll<HTMLElement>("[data-nav-tools]")) {
        const toggle = root.querySelector<HTMLButtonElement>(".nav-tools-toggle");
        const menu = root.querySelector<HTMLElement>(".tools-menu");
        if (!toggle || !menu) continue;
        const hover = window.matchMedia("(hover: hover) and (pointer: fine)");
        const set = (open: boolean) => {
          menu.hidden = !open;
          toggle.setAttribute("aria-expanded", String(open));
          root.toggleAttribute("data-open", open);
        };
        const isOpen = () => !menu.hidden;
        // After Escape, focus returns to the toggle; that focus must not reopen it.
        let suppressFocus = false;
        toggle.addEventListener("click", () => set(!isOpen()));
        root.addEventListener("mouseenter", () => { if (hover.matches) set(true); });
        root.addEventListener("mouseleave", () => { if (hover.matches && !root.contains(document.activeElement)) set(false); });
        root.addEventListener("focusin", (e) => {
          if (suppressFocus) { suppressFocus = false; return; }
          // Keyboard focus opens it; a tap or click focusing the toggle is left to the click handler.
          if ((e.target as Element).matches(":focus-visible")) set(true);
        });
        root.addEventListener("focusout", (e) => {
          const next = (e as FocusEvent).relatedTarget as Node | null;
          if (!next || !root.contains(next)) set(false);
        });
        root.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && isOpen()) {
            set(false);
            if (document.activeElement !== toggle) {
              suppressFocus = true;
              toggle.focus({ preventScroll: true });
            }
          }
        });
        document.addEventListener("click", (e) => { if (isOpen() && !root.contains(e.target as Node)) set(false); });
      }
    </script>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <Fragment set:html={loonMarkSvg({ size: 72 })} />
            <div>
              <p class="footer-statement">Canadian money, decoded. From first paycheque to <em>first home</em>.</p>
              <p>
                Plain-English explainers, honest comparisons, and tools that do real
                Canadian math. Every figure is sourced and dated, and we show our work.
              </p>
            </div>
          </div>
          <div class="footer-grid">
            <div>
              <h2>Learn</h2>
              <ul>
                <li><a href="/learn/tfsa">TFSA basics</a></li>
                <li><a href="/learn/">All explainers</a></li>
              </ul>
            </div>
            <div>
              <h2>Tools</h2>
              <ul>
                <li><a href="/calculators/">All tools</a></li>
              </ul>
            </div>
            <div>
              <h2>Compare</h2>
              <ul>
                <li><a href="/compare/tfsa-vs-rrsp">TFSA vs RRSP</a></li>
                <li><a href="/compare/">All comparisons</a></li>
              </ul>
            </div>
            <div>
              <h2>Company</h2>
              <ul>
                <li><a href="/about">About</a></li>
                <li><a href="/privacy">Privacy</a></li>
                <li><a href="/affiliate-disclosure">Affiliate disclosure</a></li>
                <li><a href="/terms">Terms of use</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="footer-status" role="note">
          <span class="dot" aria-hidden="true"></span>
          <p>
            <strong>Honest status:</strong> LoonieLogic is an early build. Pages go up
            only once their figures are checked against official sources, so the
            library is small on purpose. Anything not yet published is listed as
            "coming next", never linked.
          </p>
        </div>
        <div class="footer-disclaimers">
          <p>
            <strong>Educational only.</strong> LoonieLogic is general financial education,
            not financial advice and not a substitute for a licensed professional.
            <strong>Affiliate disclosure:</strong> we may earn a commission from some
            links on this site, disclosed before the first affiliate link on any page.
            <strong>Numbers change:</strong> tax rules, limits, and promos are verified
            against official sources on the dates shown. Check the linked official
            pages before acting.
          </p>
        </div>
        <div class="footer-base">
          <span>© {year} LoonieLogic</span>
          <span>Made for Canadians, in plain English.</span>
        </div>
      </div>
    </footer>
  </body>
</html>
